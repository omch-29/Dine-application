<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:orientation="vertical" android:padding="20dp"
        android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:text="Menu" android:textSize="16sp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/hotelTitle" android:text="Grand Palace"
            android:textSize="28sp" android:textStyle="bold" android:layout_marginBottom="15dp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <LinearLayout android:id="@+id/menuContainer" android:orientation="vertical"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/totalText" android:text="Items: 0    Total: ₹0"
            android:textSize="19sp" android:textStyle="bold" android:padding="12dp"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <Button android:id="@+id/placeOrderButton" android:text="Place Order"
            android:textSize="17sp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    </LinearLayout>
</ScrollView>
