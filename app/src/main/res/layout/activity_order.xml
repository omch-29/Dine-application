<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:gravity="center" android:padding="30dp"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <TextView android:text="✓" android:textSize="64sp" android:textStyle="bold"
        android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <TextView android:text="Order Placed!" android:textSize="30sp" android:textStyle="bold"
        android:layout_marginTop="10dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <TextView android:id="@+id/orderHotel" android:text="Grand Palace" android:textSize="20sp"
        android:layout_marginTop="22dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <TextView android:id="@+id/orderItems" android:text="Items" android:textSize="17sp"
        android:gravity="center" android:layout_marginTop="15dp"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <TextView android:id="@+id/orderTotal" android:text="Total: ₹0" android:textSize="20sp"
        android:textStyle="bold" android:layout_marginTop="15dp"
        android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <Button android:id="@+id/doneButton" android:text="Done"
        android:layout_marginTop="30dp" android:layout_width="180dp" android:layout_height="wrap_content"/>
</LinearLayout>
